# OrgIntel Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database settings
DATABASE_URL=sqlite+aiosqlite:///./data/orgintel.db

# HTTP Client & Limits (Challenge constraints: <= 2000 requests, 45m execution)
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
HTTP_CONCURRENCY_LIMIT=10
HTTP_USER_AGENT=OrgIntel-Bot/1.0 (+https://orgintel.builderr.ai)

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# LLM Provider Configuration (Deterministic extraction prioritized; LLM for fallback classification/synthesis)
# Supported providers: groq, openai, mock, none
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Brreg API settings (Authoritative Norwegian Open Registry)
BRREG_BASE_URL=https://data.brreg.no/enhetsregisteret/api
BRREG_RATE_LIMIT_RPS=5
